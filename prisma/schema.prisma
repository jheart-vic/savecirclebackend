generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AuthEventType {
  otp_requested
  otp_failed
  signed_in
  signed_out
  session_revoked
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  phoneNumber String   @unique @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions      Session[]
  authEvents    AuthEvent[]
  memberships   OrgMembership[]
  invitesSent   StaffInvite[]
  groupsCreated Group[]
  officerOf     GroupOfficer[]

  @@map("users")
}

enum OtpPurpose {
  sign_up
  sign_in
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  phoneNumber String     @map("phone_number")
  purpose     OtpPurpose
  signupName  String?    @map("signup_name")
  sendsSms    Boolean    @map("sends_sms")
  codeHash    String     @map("code_hash")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  attempts    Int        @default(0)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneNumber, createdAt])
  @@index([createdAt])
  @@map("otp_challenges")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model AuthEvent {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  phoneNumber String        @map("phone_number")
  event       AuthEventType
  ip          String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([phoneNumber, createdAt])
  @@map("auth_events")
}

enum OrganisationType {
  cooperative
  business
  informal
}

enum MoneyMode {
  gateway
  ledger
}

enum OrgRole {
  owner
  admin
  treasurer
  branch_manager
  field_officer
}

enum MembershipStatus {
  active
  removed
}

model Organisation {
  // Generated by the app, not the database: the id is set as the RLS context before the insert.
  id           String           @id @db.Uuid
  name         String
  type         OrganisationType
  contactEmail String?          @map("contact_email")
  contactPhone String           @map("contact_phone")
  moneyMode    MoneyMode        @default(ledger) @map("money_mode")
  // Organisation settings with snake_case keys, for example session_ttl_days.
  policy       Json             @default("{}")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships   OrgMembership[]
  staffInvites  StaffInvite[]
  groups        Group[]
  members       Member[]
  groupOfficers GroupOfficer[]
  rotations     Rotation[]
  rotationSlots RotationSlot[]
  cycles        Cycle[]

  @@map("organisations")
}

model OrgMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrgRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organisationId, userId])
  @@index([userId])
  @@map("org_memberships")
}

// Pending = not accepted, declined, or revoked, and not yet expired. Status is derived, never stored.
model StaffInvite {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  phoneNumber    String    @map("phone_number")
  role           OrgRole
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  declinedAt     DateTime? @map("declined_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  inviter      User         @relation(fields: [invitedBy], references: [id])

  @@index([organisationId, phoneNumber])
  @@index([phoneNumber])
  @@map("staff_invites")
}

// `fixed` is a thrift group.
enum GroupType {
  rotating
  fixed
}

enum Frequency {
  daily
  weekly
  monthly
}

enum GroupStatus {
  active
  paused
  closed
}

enum MemberStatus {
  active
  inactive
}

model Group {
  id                 String      @id @default(uuid()) @db.Uuid
  organisationId     String      @map("organisation_id") @db.Uuid
  name               String
  type               GroupType
  // Kobo per member per cycle.
  contributionAmount Int         @map("contribution_amount")
  frequency          Frequency
  // Thrift only: the first cycle's due date.
  startDate          DateTime?   @map("start_date") @db.Date
  status             GroupStatus @default(active)
  // Days relative to each due date, for example [-2, 0, 1].
  reminderOffsets    Int[]       @map("reminder_offsets")
  createdBy          String      @map("created_by") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  creator      User           @relation(fields: [createdBy], references: [id])
  members      Member[]
  officers     GroupOfficer[]
  rotations    Rotation[]
  cycles       Cycle[]

  @@index([organisationId, createdAt])
  @@map("groups")
}

model Member {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  groupId        String       @map("group_id") @db.Uuid
  name           String
  phoneNumber    String       @map("phone_number")
  joinOrder      Int          @map("join_order")
  status         MemberStatus @default(active)
  inactiveFrom   DateTime?    @map("inactive_from") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  group        Group          @relation(fields: [groupId], references: [id])
  slots        RotationSlot[]

  @@unique([groupId, phoneNumber])
  @@unique([groupId, joinOrder])
  @@index([organisationId, phoneNumber])
  @@map("members")
}

model GroupOfficer {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_officers")
}

enum RotationStatus {
  draft
  active
  paused
  completed
  dissolved
}

enum SlotStatus {
  scheduled
  paid_out
  gap
  held
  skipped
}

model Rotation {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  groupId        String         @map("group_id") @db.Uuid
  rotationNumber Int            @map("rotation_number")
  status         RotationStatus @default(draft)
  firstDueDate   DateTime?      @map("first_due_date") @db.Date
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  group        Group          @relation(fields: [groupId], references: [id])
  slots        RotationSlot[]
  cycles       Cycle[]

  @@unique([groupId, rotationNumber])
  @@map("rotations")
}

model RotationSlot {
  id             String     @id @default(uuid()) @db.Uuid
  organisationId String     @map("organisation_id") @db.Uuid
  rotationId     String     @map("rotation_id") @db.Uuid
  memberId       String     @map("member_id") @db.Uuid
  position       Int
  status         SlotStatus @default(scheduled)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  rotation     Rotation     @relation(fields: [rotationId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])
  payoutCycles Cycle[]

  @@unique([rotationId, position])
  @@unique([rotationId, memberId])
  @@map("rotation_slots")
}

model Cycle {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  groupId        String    @map("group_id") @db.Uuid
  // Null for thrift cycles (feature 9).
  rotationId     String?   @map("rotation_id") @db.Uuid
  cycleNumber    Int       @map("cycle_number")
  // Stored dates are the truth once generated.
  dueDate        DateTime  @map("due_date") @db.Date
  // Kobo, copied from the group when the cycle is created.
  amountDue      Int       @map("amount_due")
  payoutSlotId   String?   @map("payout_slot_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  group        Group         @relation(fields: [groupId], references: [id])
  rotation     Rotation?     @relation(fields: [rotationId], references: [id])
  payoutSlot   RotationSlot? @relation(fields: [payoutSlotId], references: [id])

  @@unique([rotationId, cycleNumber])
  @@index([groupId, dueDate])
  @@map("cycles")
}
