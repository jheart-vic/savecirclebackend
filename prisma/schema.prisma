generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AuthEventType {
  otp_requested
  otp_failed
  signed_in
  signed_out
  session_revoked
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  phoneNumber String   @unique @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions    Session[]
  authEvents  AuthEvent[]
  memberships OrgMembership[]
  invitesSent StaffInvite[]

  @@map("users")
}

enum OtpPurpose {
  sign_up
  sign_in
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  phoneNumber String     @map("phone_number")
  purpose     OtpPurpose
  signupName  String?    @map("signup_name")
  sendsSms    Boolean    @map("sends_sms")
  codeHash    String     @map("code_hash")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  attempts    Int        @default(0)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneNumber, createdAt])
  @@index([createdAt])
  @@map("otp_challenges")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model AuthEvent {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  phoneNumber String        @map("phone_number")
  event       AuthEventType
  ip          String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([phoneNumber, createdAt])
  @@map("auth_events")
}

enum OrganisationType {
  cooperative
  business
  informal
}

enum MoneyMode {
  gateway
  ledger
}

enum OrgRole {
  owner
  admin
  treasurer
  branch_manager
  field_officer
}

enum MembershipStatus {
  active
  removed
}

model Organisation {
  // Generated by the app, not the database: the id is set as the RLS context before the insert.
  id           String           @id @db.Uuid
  name         String
  type         OrganisationType
  contactEmail String?          @map("contact_email")
  contactPhone String           @map("contact_phone")
  moneyMode    MoneyMode        @default(ledger) @map("money_mode")
  // Organisation settings with snake_case keys, for example session_ttl_days.
  policy       Json             @default("{}")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships  OrgMembership[]
  staffInvites StaffInvite[]

  @@map("organisations")
}

model OrgMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrgRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organisationId, userId])
  @@index([userId])
  @@map("org_memberships")
}

// Pending = not accepted, declined, or revoked, and not yet expired. Status is derived, never stored.
model StaffInvite {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  phoneNumber    String    @map("phone_number")
  role           OrgRole
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  declinedAt     DateTime? @map("declined_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  inviter      User         @relation(fields: [invitedBy], references: [id])

  @@index([organisationId, phoneNumber])
  @@index([phoneNumber])
  @@map("staff_invites")
}
