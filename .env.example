# Neon PostgreSQL. Two connections with two different roles:
# DATABASE_URL: pooled host ("-pooler"), role savecircle_app. Used by the running app.
#   This role cannot bypass row-level security. Create it once per Neon branch in the
#   SQL editor (Neon's Connect dialog does not list SQL-created roles, so write the URL by hand):
#   CREATE ROLE savecircle_app WITH LOGIN PASSWORD '<password>' NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;
#   URL-encode the password if it has symbols such as @ : / ? # % &.
DATABASE_URL="postgresql://savecircle_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: direct host (no "-pooler"), the owner role (e.g. neondb_owner). Used only by
#   Prisma migrations, which create tables and grant the app role access to them.
DIRECT_URL="postgresql://OWNER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3000
# Required: development, production, or test. The server will not start without it.
NODE_ENV=development

# The PWA's origin; CORS and the CSRF origin check allow only this.
FRONTEND_ORIGIN="http://localhost:5173"
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Optional, default 30.
SESSION_TTL_DAYS=30

# Termii SMS for sign-in codes. Leave all three empty in development to skip
# sending (the code comes back as devCode); all three are required in production.
# Base URL is shown on the Termii dashboard, e.g. https://v3.api.termii.com
TERMII_BASE_URL=""
TERMII_API_KEY=""
# Approved sender ID, 3 to 11 characters.
TERMII_SENDER_ID=""
# dnd reaches numbers on Do-Not-Disturb (use for OTPs); generic does not.
TERMII_CHANNEL=dnd
# Most sign-in codes sent across all phones in 24 hours.
OTP_DAILY_LIMIT=500

# Cloudflare Turnstile secret key (Dashboard > Turnstile > your widget). Required in
# production. Leave empty in development to use Cloudflare's always-pass test secret.
# Tokens are only accepted from the FRONTEND_ORIGIN hostname when a real key is set.
TURNSTILE_SECRET_KEY=""
