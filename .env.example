# Neon PostgreSQL. Copy both strings from the Neon console (Connect dialog).
# Pooled connection (host contains "-pooler"), used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler"), used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3000
NODE_ENV=development

# The PWA's origin; CORS and the CSRF origin check allow only this.
FRONTEND_ORIGIN="http://localhost:5173"
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Optional, default 30.
SESSION_TTL_DAYS=30

# Termii SMS for sign-in codes. Leave all three empty in development to skip
# sending (the code comes back as devCode); all three are required in production.
# Base URL is shown on the Termii dashboard, e.g. https://v3.api.termii.com
TERMII_BASE_URL=""
TERMII_API_KEY=""
# Approved sender ID, 3 to 11 characters.
TERMII_SENDER_ID=""
# dnd reaches numbers on Do-Not-Disturb (use for OTPs); generic does not.
TERMII_CHANNEL=dnd
# Most sign-in codes sent across all phones in 24 hours.
OTP_DAILY_LIMIT=500
